hugo.linux

# Temporary lock file while building
/.hugo_build.lock

# macOS / IDE
.DS_Store
.idea/

# Raw PukiWiki backup & sensitive files (DO NOT COMMIT)
/*.zip
net2ftp*.zip
!content/**/*.zip
*.php
.htpasswd
/wiki/
/attach/
/backup/
/cache/
/counter/
/diff/
/lib/
/plugin/
/skin/
