RewriteCond %{QUERY_STRING} ^%E7%B7%B4%E7%BF%92%E5%95%8F%E9%A1%8C(?:%2F|/)%E8%A7%A3%E7%AD%94%E4%BE%8B(?:%2F|/)%E9%80%A3%E7%AB%8B%E6%96%B9%E7%A8%8B%E5%BC%8F%E3%82%92%E8%A7%A3%E3%81%8F(?:%2F|/)C(?:\+|%2B)(?:\+|%2B)(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/練習問題/解答例/連立方程式を解く/C--/ [R=301,NE,QSD,L]

# 色、いわゆるカラー -> docs/色-いわゆるカラー/
RewriteCond %{QUERY_STRING} ^%E8%89%B2%E3%80%81%E3%81%84%E3%82%8F%E3%82%86%E3%82%8B%E3%82%AB%E3%83%A9%E3%83%BC(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/色-いわゆるカラー/ [R=301,NE,QSD,L]

# 解答例/FizzBuzz/Excel VBA -> docs/解答例/FizzBuzz/Excel-VBA/
RewriteCond %{QUERY_STRING} ^%E8%A7%A3%E7%AD%94%E4%BE%8B(?:%2F|/)FizzBuzz(?:%2F|/)Excel(?:\+|%20)VBA(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/解答例/FizzBuzz/Excel-VBA/ [R=301,NE,QSD,L]

# 解答例/世界のナベアツ問題/Excel VBA -> docs/解答例/世界のナベアツ問題/Excel-VBA/
RewriteCond %{QUERY_STRING} ^%E8%A7%A3%E7%AD%94%E4%BE%8B(?:%2F|/)%E4%B8%96%E7%95%8C%E3%81%AE%E3%83%8A%E3%83%99%E3%82%A2%E3%83%84%E5%95%8F%E9%A1%8C(?:%2F|/)Excel(?:\+|%20)VBA(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/解答例/世界のナベアツ問題/Excel-VBA/ [R=301,NE,QSD,L]

# 解答例/二次方程式の解/Excel VBA -> docs/解答例/二次方程式の解/Excel-VBA/
RewriteCond %{QUERY_STRING} ^%E8%A7%A3%E7%AD%94%E4%BE%8B(?:%2F|/)%E4%BA%8C%E6%AC%A1%E6%96%B9%E7%A8%8B%E5%BC%8F%E3%81%AE%E8%A7%A3(?:%2F|/)Excel(?:\+|%20)VBA(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/解答例/二次方程式の解/Excel-VBA/ [R=301,NE,QSD,L]

# 解答例/線形合同法/Excel VBA -> docs/解答例/線形合同法/Excel-VBA/
RewriteCond %{QUERY_STRING} ^%E8%A7%A3%E7%AD%94%E4%BE%8B(?:%2F|/)%E7%B7%9A%E5%BD%A2%E5%90%88%E5%90%8C%E6%B3%95(?:%2F|/)Excel(?:\+|%20)VBA(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/解答例/線形合同法/Excel-VBA/ [R=301,NE,QSD,L]

# 解答例/転置行列/Excel VBA -> docs/解答例/転置行列/Excel-VBA/
RewriteCond %{QUERY_STRING} ^%E8%A7%A3%E7%AD%94%E4%BE%8B(?:%2F|/)%E8%BB%A2%E7%BD%AE%E8%A1%8C%E5%88%97(?:%2F|/)Excel(?:\+|%20)VBA(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/解答例/転置行列/Excel-VBA/ [R=301,NE,QSD,L]

# 資格・試験 -> docs/資格-試験/
RewriteCond %{QUERY_STRING} ^%E8%B3%87%E6%A0%BC%E3%83%BB%E8%A9%A6%E9%A8%93(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/資格-試験/ [R=301,NE,QSD,L]

# Ｅｘｃｅｌ VBA -> docs/Ｅｘｃｅｌ-VBA/
RewriteCond %{QUERY_STRING} ^%EF%BC%A5%EF%BD%98%EF%BD%83%EF%BD%85%EF%BD%8C(?:\+|%20)VBA(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/Ｅｘｃｅｌ-VBA/ [R=301,NE,QSD,L]

# ----------------------------------------------------
# 4. 通常の旧 PukiWiki URL (?ページ名 または ?ページ名.html) を /wiki/docs/ページ名/ にリダイレクト
# ----------------------------------------------------
RewriteCond %{QUERY_STRING} ^([^&=]+?)(?:\.html)?$
RewriteRule ^(?:index\.php)?$ docs/%1/ [R=301,NE,QSD,L]

# index.php へのクエリなしアクセスをトップへリダイレクト
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^index\.php$ /wiki/ [R=301,L]
