# ======================================================================
# VIPPROG WIKI - Apache mod_rewrite .htaccess
# Hugo移行に伴うURL永続化・旧PukiWiki/RewriteMapリダイレクト設定
# ======================================================================

RewriteEngine On
RewriteBase /wiki/

# 404 エラーページ指定
ErrorDocument 404 /wiki/404.html

# ----------------------------------------------------------------------
# 1. 静的アセットおよびクエリなしの実在ファイル/ディレクトリはそのまま配信
# ----------------------------------------------------------------------
# 静的アセット（画像、CSS、JS、フォント等）はクエリの有無に関わらず即座に配信
RewriteCond %{REQUEST_URI} \.(?:css|js|png|jpe?g|gif|svg|ico|webp|woff2?|ttf|eot|xml|txt|json)$ [NC]
RewriteRule ^ - [L]

# クエリ文字列がない通常のアクセスで実在ファイルまたはディレクトリの場合は即座に配信
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ----------------------------------------------------------------------
# 2. 廃止されたWiki機能・システムページは 410 Gone
# ----------------------------------------------------------------------
# クエリ形式
RewriteCond %{QUERY_STRING} ^(?:cmd|plugin)=(?!read\b) [NC,OR]
RewriteCond %{QUERY_STRING} ^(?::config|MenuBar|RecentChanges|RecentDeleted|InterWiki.*|SandBox|FormattingRules|Help|test)(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ - [G,L]

# パス形式
RewriteRule ^(?::config/|MenuBar|RecentChanges|RecentDeleted|InterWiki.*|SandBox|FormattingRules|Help|test)(?:\.html)?$ - [G,L]

# ----------------------------------------------------------------------
# 3. トップページ (FrontPage / トップページ)
# ----------------------------------------------------------------------
RewriteCond %{QUERY_STRING} ^(?:FrontPage|トップページ)(?:\.html)?$ [NC,OR]
RewriteCond %{QUERY_STRING} ^(?:cmd|plugin)=read&(?:amp;)?(?:page=)?(?:FrontPage|トップページ)$ [NC]
RewriteRule ^(?:index\.php)?$ /wiki/ [R=301,L,QSD]
RewriteRule ^(?:FrontPage|トップページ)(?:\.html)?$ /wiki/ [R=301,L,QSD]

# ----------------------------------------------------------------------
# 4. 個別リダイレクト
# (RewriteMapエイリアス / 過去の改名履歴 / スラッグ差異 全184件)
# ----------------------------------------------------------------------
# [RewriteMap] first -> /wiki/docs/はじめてなの-やさしくして-/
RewriteCond %{QUERY_STRING} ^(?:(?:plugin|cmd)=read&(?:amp;)?page=)?first(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ /wiki/docs/はじめてなの-やさしくして-/ [R=301,L,QSD]
RewriteRule ^first(?:\.html)?$ /wiki/docs/はじめてなの-やさしくして-/ [R=301,L,QSD]
