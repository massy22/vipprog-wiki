RewriteCond %{QUERY_STRING} ^(?:(?:plugin|cmd)=read&(?:amp;)?page=)?faq(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ /wiki/docs/よくある質問/ [R=301,L,QSD]
RewriteRule ^faq(?:\.html)?$ /wiki/docs/よくある質問/ [R=301,L,QSD]
