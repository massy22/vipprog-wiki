# ----------------------------------------------------------------------
# 5. 汎用フォールバック: その他の .html パスリクエスト
# (例: /wiki/専ブラ開発への道.html -> /wiki/docs/専ブラ開発への道/)
# ----------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(?!docs/|categories/|tags/|assets/|katex/|icons/|asciinema/|index\.html$|404\.html$)(.+?)\.html$ /wiki/docs/$1/ [R=301,L,QSD]

# ----------------------------------------------------------------------
# 6. 汎用フォールバック: その他のクエリ文字列リクエスト (?ページ名)
# ----------------------------------------------------------------------
RewriteCond %{QUERY_STRING} ^(?:plugin|cmd)=read&(?:amp;)?page=([^&]+) [NC,OR]
RewriteCond %{QUERY_STRING} ^page=([^&]+) [NC,OR]
RewriteCond %{QUERY_STRING} ^([^&=]+?)(?:\.html)?$
RewriteRule ^(?:index\.php)?$ docs/%1/ [R=301,NE,QSD,L]

# ----------------------------------------------------------------------
# 7. クエリなしの index.php はルートへ
# ----------------------------------------------------------------------
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^index\.php$ /wiki/ [R=301,L]
