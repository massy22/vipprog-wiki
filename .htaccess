# mod_rewrite エンジンを有効化
RewriteEngine On

# サーバー上のベースディレクトリを指定
RewriteBase /wiki/

# カスタム 404 エラーページ
ErrorDocument 404 /wiki/404.html

# ----------------------------------------------------
# 0. PukiWiki システムページ・削除済みページ・プラグイン操作を 410 Gone にする
# ----------------------------------------------------
RewriteCond %{QUERY_STRING} ^(?:cmd|plugin)=(?!read\b) [NC,OR]
RewriteCond %{QUERY_STRING} ^(?::|%3A) [NC,OR]
RewriteCond %{QUERY_STRING} ^(?:MenuBar|RecentChanges|RecentDeleted|InterWiki|InterWikiName|InterWikiSandBox|SandBox|SanbaBox|FormattingRules|Help|BracketName|WikiName|WikiEngines|WikiWikiWeb|YukiWiki|AutoTicketLinkName|RenameLog|test|PukiWiki.*)(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ - [G,L]

# cmd=read&page=XXX 形式の旧URLを正規化
RewriteCond %{QUERY_STRING} (?:^|&)cmd=read(?:&|$)
RewriteCond %{QUERY_STRING} (?:^|&)page=([^&]+)
RewriteRule ^(?:index\.php)?$ /wiki/?%1 [R=301,NE,L]

# ----------------------------------------------------
# 1. トップページ (FrontPage / プログラミングスレまとめ in VIP) のリダイレクト
# ----------------------------------------------------
RewriteCond %{QUERY_STRING} ^(?:FrontPage|%E3%83%97%E3%83%AD%E3%82%B0%E3%83%A9%E3%83%9F%E3%83%B3%E3%82%B0%E3%82%B9%E3%83%AC%E3%81%BE%E3%81%A8%E3%82%81(?:\+|%20)in(?:\+|%20)VIP|%E3%83%97%E3%83%AD%E3%82%B0%E3%83%A9%E3%83%9F%E3%83%B3%E3%82%B0%E3%82%B9%E3%83%AC(?:\+|%20)in(?:\+|%20)VIP)(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ /wiki/ [R=301,QSD,L]

# ----------------------------------------------------
# 2. 旧 :config/RewriteMap エイリアスおよび階層移動ページのリダイレクト
# ----------------------------------------------------
RewriteCond %{QUERY_STRING} ^first(?:\.html)?$
RewriteRule ^(?:index\.php)?$ docs/まず最初に読むページ/ [R=301,NE,QSD,L]

RewriteCond %{QUERY_STRING} ^faq(?:\.html)?$
