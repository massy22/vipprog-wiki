# ----------------------------------------------------
# 3. ページ名に空白や記号 (+, #, ・, (, ) 等) を含みスラッグ変換されたページの個別リダイレクト
# ----------------------------------------------------
# Abstract Factory -> docs/Abstract-Factory/
RewriteCond %{QUERY_STRING} ^Abstract(?:\+|%20)Factory(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/Abstract-Factory/ [R=301,NE,QSD,L]

# Access VBA -> docs/Access-VBA/
RewriteCond %{QUERY_STRING} ^Access(?:\+|%20)VBA(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/Access-VBA/ [R=301,NE,QSD,L]

# C Sharp /C Sharp/チュートリアル/コンソール編 -> docs/C-Sharp-/C-Sharp/チュートリアル/コンソール編/
RewriteCond %{QUERY_STRING} ^C(?:\+|%20)Sharp(?:\+|%20)(?:%2F|/)C(?:\+|%20)Sharp(?:%2F|/)%E3%83%81%E3%83%A5%E3%83%BC%E3%83%88%E3%83%AA%E3%82%A2%E3%83%AB(?:%2F|/)%E3%82%B3%E3%83%B3%E3%82%BD%E3%83%BC%E3%83%AB%E7%B7%A8(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/C-Sharp-/C-Sharp/チュートリアル/コンソール編/ [R=301,NE,QSD,L]

# C++初心者ガイド -> docs/C--初心者ガイド/
RewriteCond %{QUERY_STRING} ^C(?:\+|%2B)(?:\+|%2B)%E5%88%9D%E5%BF%83%E8%80%85%E3%82%AC%E3%82%A4%E3%83%89(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/C--初心者ガイド/ [R=301,NE,QSD,L]

# Common Lisp -> docs/Common-Lisp/
RewriteCond %{QUERY_STRING} ^Common(?:\+|%20)Lisp(?:\.html)?$ [NC]
RewriteRule ^(?:index\.php)?$ docs/Common-Lisp/ [R=301,NE,QSD,L]

# C言語 - よくありそうな質問 -> docs/C言語---よくありそうな質問/
RewriteCond %{QUERY_STRING} ^C%E8%A8%80%E8%AA%9E(?:\+|%20)-(?:\+|%20)%E3%82%88%E3%81%8F%E3%81%82%E3%82%8A%E3%81%9D%E3%81%86%E3%81%AA%E8%B3%AA%E5%95%8F(?:\.html)?$ [NC]
